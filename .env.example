# Server Settings (TORRGATE_PORT falls back to the hosting platform PORT)
TORRGATE_PORT=8443
TORRGATE_HOST=0.0.0.0
# TORRGATE_API_KEY=your_secret_api_key_here
TORRGATE_CACHE_TTL_SECONDS=300
TORRGATE_REQUEST_TIMEOUT_MS=10000
TORRGATE_MAX_CONCURRENT_REQUESTS=10
# Restrict cross-origin browser response access to one HTTP(S) origin (defaults to *)
# TORRGATE_CORS_ORIGIN=https://client.example
# Behind a reverse proxy, trust it so throttling sees real client addresses (defaults to true on Vercel)
# TORRGATE_TRUST_PROXY=loopback

# Upstash Redis Cache (optional: persistent key-value cache across Vercel cold starts)
# Falls back to KV_REST_API_* or UPSTASH_REDIS_REST_* populated by hosting integrations
# TORRGATE_KV_REST_API_URL=https://your-upstash-database.upstash.io
# TORRGATE_KV_REST_API_TOKEN=your_upstash_rest_token_here

# User-Agent (optional: match the browser used to obtain session cookies)
# TORRGATE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# Outbound HTTP/HTTPS Proxy (optional: bypass ISP/Cloudflare geo-restrictions)
# Falls back to HTTPS_PROXY, HTTP_PROXY, https_proxy, then http_proxy
# TORRGATE_PROXY=http://user:password@proxy.example.com:8080

# Time zone trackers display release times in (optional; per tracker via TORRGATE_<ID>_TIMEZONE)
# TORRGATE_TRACKER_TIMEZONE=Europe/Moscow

# Default tracker credentials (optional; per-tracker credentials take precedence)
# TORRGATE_TRACKER_USERNAME=sample_user
# TORRGATE_TRACKER_PASSWORD=sample_password

# API version in the OpenAPI specification (optional; defaults to the package version)
# TORRGATE_VERSION=1.0.0

# ==============================================================================
# Tracker Session Cookies & Credentials
# ==============================================================================
# Variable names are derived dynamically from the tracker definition's `id`:
#   1. Identifier is converted to UPPERCASE.
#   2. Non-alphanumeric characters (-, ., spaces) are replaced with "_".
#   3. Prefixed with TORRGATE_${INDEXER_ID}_COOKIE / USERNAME / PASSWORD.
#
# Example with a made-up tracker (`id: sample-tracker.org` -> `SAMPLE_TRACKER_ORG`):
#   TORRGATE_SAMPLE_TRACKER_ORG_COOKIE="session_id=...; auth_token=..."
#   TORRGATE_SAMPLE_TRACKER_ORG_USERNAME="sample_user"
#   TORRGATE_SAMPLE_TRACKER_ORG_PASSWORD="sample_password"
#
# To obtain cookies from your desktop browser:
# 1. Log in to the tracker in your browser.
# 2. Open Developer Tools (F12) -> Application (or Storage) -> Cookies.
# 3. Copy the required cookie key/value pairs.
